# Copy to .env.local and fill in. Never commit real values.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Supabase pooler connection string
DATABASE_URL=
RESEND_API_KEY=
# Without a verified domain Resend only delivers to the Resend account owner, so ARJUN_EMAIL must be that address.
RESEND_FROM=onboarding@resend.dev
ARJUN_EMAIL=
ARJUN_PASSWORD=
HUBSPOT_PRIVATE_APP_TOKEN=
# Random string; cron routes require Authorization: Bearer CRON_SECRET
CRON_SECRET=
COMPANY_NAME=Keka
TEAM_NAME="Enterprise Sales Team"
USER_NAME=Arjun
GEMINI_DAILY_CALL_CAP=300
MAX_ARTICLES_PER_RUN=120
# Optional: public URL used in email links (defaults to the Vercel production URL)
APP_URL=
